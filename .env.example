# =============================================================================
# Constellation Configuration
# Copy this file to .env and fill in your keys.
# =============================================================================

# --- Providers ---
# LLM: "groq" (hosted, default) or "ollama" (local, needs: pip install langchain-ollama).
# Embeddings: "google" (hosted, default) or "ollama" (local).
# With both set to ollama no API keys are needed and note text stays on your machine.
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=google

# Ollama settings (only used for providers set to "ollama").
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- API Keys ---
# Only needed for the hosted providers (Groq for the LLM, Google for embeddings).
# Multiple keys are supported for automatic rate-limit rotation.
GROQ_API_KEY_1=gsk_your_groq_api_key_here
# GROQ_API_KEY_2=gsk_your_secondary_groq_api_key_here

GOOGLE_API_KEY_1=AIzaSy_your_google_gemini_api_key_here
# GOOGLE_API_KEY_2=AIzaSy_your_secondary_google_api_key_here

# --- Vault Configuration ---
# Optional: Set a default Obsidian vault directory to skip prompting.
# OBSIDIAN_VAULT_DIR=/Users/username/Documents/MyVault

# Comma-separated list of vault folders to exclude from linking.
# Matches folder names anywhere in the vault, or relative paths.
EXCLUDED_DIRS=Templates,Archive,Daily Notes

# --- Linking Behavior ---
# Maximum number of related wikilinks to append to any single note (default: 5).
MAX_LINKS_PER_NOTE=5

# When true, links include brief reasoning: "- [[Target]] — reason" (default: false).
ANNOTATE_LINKS=false

# When true, every link A -> B also writes B -> A, still subject to the cap (default: false).
BACKLINKS=false

# When true, tags go into the YAML frontmatter "tags:" list instead of a "## Tags"
# section. Your own tags are kept; only tags Constellation added are removed later (default: false).
TAGS_IN_FRONTMATTER=false

# --- Safety ---
# Notes are backed up to <vault>/.constellation_backups/<timestamp>/ before every
# write. How many backups to keep (default: 10).
MAX_BACKUPS=10

# Texts per embedding request (falls back to one request per text on errors).
EMBED_BATCH_SIZE=50

# --- Models ---
# Google Gemini embedding model
EMBEDDING_MODEL=models/gemini-embedding-2

# Primary LLM model for extraction and reasoning
LLM_MODEL=openai/gpt-oss-120b
LLM_EXTRACTION=openai/gpt-oss-120b
LLM_VERIFICATION=openai/gpt-oss-120b
LLM_RELATIONSHIP=openai/gpt-oss-120b

# --- Tuning & Limits ---
# Max output tokens per LLM completion (Groq TPM budgeting)
LLM_MAX_OUTPUT_TOKENS=2048

# Max character length of note text sent to LLM
LLM_MAX_NOTE_CHARS=12000

# Concurrency for async batch processing
LLM_CONCURRENCY=2

# Reasoning effort for reasoning models ("low", "medium", "high", or empty to omit)
LLM_REASONING_EFFORT=low
